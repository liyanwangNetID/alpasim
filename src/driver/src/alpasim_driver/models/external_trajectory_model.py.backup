"""External trajectory model.

The initial implementation returns a deterministic trajectory in the
current ego/rig frame. Later, the fixed trajectory source can be replaced
by a thread-safe buffer populated by ROS 2 or another external controller.
"""

from __future__ import annotations

import logging

import numpy as np
import torch

from ..schema import ModelConfig
from .base import (
    BaseTrajectoryModel,
    DriveCommand,
    ModelPrediction,
    PredictionInput,
)

logger = logging.getLogger(__name__)


class ExternalTrajectoryModel(BaseTrajectoryModel):
    """Return a trajectory supplied by an external source.

    Initial validation implementation:
        Generate a fixed straight trajectory.

    Rig-frame convention:
        +x: forward
        +y: left
        heading: counter-clockwise from +x, in radians
    """

    DEFAULT_HORIZON_S = 4.0
    DEFAULT_SPEED_MPS = 2.0

    @classmethod
    def from_config(
        cls,
        model_cfg: ModelConfig,
        device: torch.device,
        camera_ids: list[str],
        context_length: int | None,
        output_frequency_hz: int,
    ) -> "ExternalTrajectoryModel":
        """Create a model instance from the Driver configuration."""

        del model_cfg

        return cls(
            device=device,
            camera_ids=camera_ids,
            context_length=context_length,
            output_frequency_hz=output_frequency_hz,
            horizon_s=cls.DEFAULT_HORIZON_S,
            target_speed_mps=cls.DEFAULT_SPEED_MPS,
        )

    def __init__(
        self,
        device: torch.device,
        camera_ids: list[str],
        context_length: int | None,
        output_frequency_hz: int,
        horizon_s: float = DEFAULT_HORIZON_S,
        target_speed_mps: float = DEFAULT_SPEED_MPS,
    ) -> None:
        """Initialize the external trajectory model."""

        self._device = device
        self._camera_ids = list(camera_ids)
        self._context_length = (
            int(context_length) if context_length is not None else 1
        )
        self._output_frequency_hz = int(output_frequency_hz)
        self._horizon_s = float(horizon_s)
        self._target_speed_mps = float(target_speed_mps)

        if self._context_length <= 0:
            raise ValueError("context_length must be positive")

        if self._output_frequency_hz <= 0:
            raise ValueError("output_frequency_hz must be positive")

        if self._horizon_s <= 0.0:
            raise ValueError("horizon_s must be positive")

        self._num_waypoints = max(
            1,
            int(round(self._horizon_s * self._output_frequency_hz)),
        )

        logger.info(
            "Initialized ExternalTrajectoryModel: "
            "speed=%.2f m/s, horizon=%.2f s, frequency=%d Hz, points=%d",
            self._target_speed_mps,
            self._horizon_s,
            self._output_frequency_hz,
            self._num_waypoints,
        )

    @property
    def camera_ids(self) -> list:
        """Camera IDs requested by this model."""

        return self._camera_ids

    @property
    def context_length(self) -> int:
        """Number of historical observation frames required."""

        return self._context_length

    @property
    def output_frequency_hz(self) -> int:
        """Frequency represented by consecutive trajectory points."""

        return self._output_frequency_hz

    def _encode_command(self, command: DriveCommand) -> torch.Tensor:
        """Encode a semantic command.

        The fixed trajectory implementation does not use the command, but
        BaseTrajectoryModel requires this method.
        """

        del command
        return torch.zeros(1, dtype=torch.float32, device=self._device)

    def predict(self, inputs: PredictionInput) -> ModelPrediction:
        """Return a fixed straight trajectory in the current rig frame."""

        del inputs

        time_from_start_s = (
            np.arange(
                1,
                self._num_waypoints + 1,
                dtype=np.float64,
            )
            / self._output_frequency_hz
        )

        x = self._target_speed_mps * time_from_start_s
        y = np.zeros_like(x)

        trajectory_xy = np.column_stack((x, y))
        headings = np.zeros(self._num_waypoints, dtype=np.float64)

        logger.debug(
            "External trajectory: points=%d, final=(%.2f, %.2f), speed=%.2f",
            len(trajectory_xy),
            trajectory_xy[-1, 0],
            trajectory_xy[-1, 1],
            self._target_speed_mps,
        )

        return ModelPrediction(
            trajectory_xy=trajectory_xy,
            headings=headings,
        )
